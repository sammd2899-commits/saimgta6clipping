{
  "permanent_defaults": {
    "default_ig_location": "Miami, Florida",
    "youtube_made_for_kids": false,
    "youtube_comments_enabled": true,
    "instagram_comments_enabled": true,
    "dm_share_hook_position": "top_of_caption",
    "default_dm_share_trigger": "Send this to your GTA duo 😭👇",
    "notes": "Permanent global defaults applied to every future clip and campaign unless explicitly overridden."
  },
  "video": {
    "width": 1080,
    "height": 1920,
    "fps": 60.0,
    "video_bitrate": "6M",
    "vcodec": "libx264",
    "pix_fmt": "yuv420p",
    "audio_loudnorm_lufs": -14,
    "trim_silence_over_sec": 0.6,
    "target_duration_sec": [18, 38],
    "hard_duration_bounds": [12, 55]
  },
  "layout": {
    "mode": "stacked_split_screen",
    "facecam_crop": "430:277:12:428",
    "facecam_top_ratio": 0.35,
    "facecam_height_px": 672,
    "gameplay_bottom_ratio": 0.65,
    "gameplay_height_px": 1248,
    "fallback_mode": "blurred_fill"
  },
  "safe_zones": {
    "universal_safe_box": {
      "x": [60, 940],
      "y": [250, 1490],
      "width": 890,
      "height": 1250,
      "description": "Zero text, faces, or key HUD elements covered by Instagram Reels or YouTube Shorts UI overlays"
    },
    "dead_zones": {
      "top_bar": {
        "y": [0, 250],
        "reason": "Covered by search, back, sound, and brand camera notches"
      },
      "bottom_bar": {
        "y": [1490, 1920],
        "height_px": 430,
        "reason": "Covered by username, follow button, caption, and audio title"
      },
      "right_rail": {
        "x": [940, 1080],
        "width_px": 140,
        "reason": "Covered by like, comment, share, remix, and bookmark action buttons"
      }
    }
  },
  "hook_banner": {
    "position_y": 290,
    "duration_sec": 2.5,
    "word_count_range": [4, 7],
    "font_size_px": 56,
    "text_color": "#FFFFFF",
    "bg_color": "#0E0E12EE",
    "border_color": "#D4AF37",
    "border_width_px": 3,
    "corner_radius_px": 24,
    "padding_px": [28, 48]
  },
  "captions": {
    "font_name": "Montserrat",
    "font_fallback": "Arial Bold",
    "font_size_px": 68,
    "active_word_color": "#FFE600",
    "inactive_word_color": "#FFFFFF",
    "outline_color": "#000000",
    "outline_width_px": 5,
    "y_position_range": [1150, 1320],
    "margin_v_from_bottom": 650,
    "alignment": 2,
    "words_per_chunk": [2, 4],
    "animation": "word_by_word_pop"
  },
  "watermark": {
    "position": "upper_right_safe",
    "x": 810,
    "y": 260,
    "width": 210,
    "height": 70,
    "aspect_ratio": "3:1",
    "duration": "100%",
    "preserve_aspect_ratio": true,
    "allow_crop_or_stretch": false,
    "zero_overlap_with_hook_banner": true
  },
  "content_filters": {
    "skip_story_cutscenes": true,
    "skip_licensed_music_audio": true,
    "skip_nsfw_scenes": true,
    "skip_silent_driving": true,
    "prioritize_themes": [
      "smart_or_creepy_npc_ai_reactions",
      "absurd_vehicle_or_police_escape_chaos",
      "shocking_crash_physics_or_glitches",
      "hidden_map_easter_eggs_and_high_risk_stunts",
      "instant_karma_heist_fails_and_chat_trolling"
    ]
  },
  "platform_metadata": {
    "default_ig_location": "Miami, Florida",
    "youtube_made_for_kids": false,
    "youtube_comments_enabled": true,
    "instagram_comments_enabled": true,
    "dm_share_hook_position": "top_of_caption",
    "instagram_reels": {
      "default_ig_location": "Miami, Florida",
      "comments_enabled": true,
      "max_hashtags": 5,
      "required_campaign_tags": ["#GTA6", "#GTAVI"],
      "extra_tags_max_2": ["#GTA6Clips", "#GamingClips", "#GrandTheftAutoVI"],
      "dm_share_triggers": [
        "Send this to your GTA duo 😭👇",
        "Tag the friend who drives like this 😭👇",
        "Would you survive this chase? 👇",
        "Rate this escape 1–10 💀👇"
      ],
      "mandatory_credit": "Watch the official livestream creator",
      "mandatory_channel_tag": "@Creator",
      "cover_frame": "1080x1920 centered reaction frame (1:1 profile grid safe)"
    },
    "youtube_shorts": {
      "made_for_kids": false,
      "comments_enabled": true,
      "title_max_chars": 65,
      "title_style": "curiosity_gap_english_plus_#Shorts",
      "category": "Gaming",
      "language": "en-US",
      "likes_visible": true,
      "mandatory_credit_in_description": "Watch the official livestream creator",
      "mandatory_channel_tag": "@Creator",
      "description_tags": ["#GTA6", "#GTAVI", "#Shorts"]
    }
  }
}
