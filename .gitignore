# Environment and Secrets (CRITICAL - NEVER COMMIT)
.env
*.env
.env.*
!.env.example

# Backup files
*.bak
*.backup

# Local Configuration overrides (only .example.json committed)
config/zernio_accounts.json
config/active_campaign.json
config/schedule_config.json
!config/*.example.json
!config/editing_rules.json

# Local Memory & Continuous Learning Runtime State (only .template files committed)
memory/performance_log.json
memory/viral_dna_weights.json
memory/learned_rules.md
!memory/*.template.*
!memory/*.template.json

# Intermediate clip processing and raw media
temp/
output/
*.mp4
*.mov
*.avi
*.mkv
*.jpg
*.jpeg
*.png
*.wav
*.ass

# Campaign assets (logos/watermarks - only .gitkeep committed)
assets/*.png
assets/*.jpg
assets/*.jpeg
!assets/.gitkeep

# User state and personal logs
state/
logs/

# Python caches and virtual environments
__pycache__/
*.py[cod]
*$py.class
*.pyc
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# IDE and Editor configs
.vscode/
.idea/
*.swp
*.swo
