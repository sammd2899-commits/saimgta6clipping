# SaimGTA6Clipping Configuration
# Copy this file to .env and fill in your credentials.
# NEVER commit your real .env or secrets to GitHub!

# Zernio Multi-Platform API Key (from https://zernio.com)
ZERNIO_API_KEY=your_zernio_api_key_here

# Posting interval in hours between queued clips (default: 2.0 hours)
POST_INTERVAL_HOURS=2.0

# Optional: Telegram bot notifications for published clips
# Create a bot via @BotFather on Telegram to get your token.
TELEGRAM_BOT_TOKEN=
# Send /start to your bot, then run 'python scripts/telegram_notifier.py --detect' to auto-save your Chat ID.
TELEGRAM_CHAT_ID=
